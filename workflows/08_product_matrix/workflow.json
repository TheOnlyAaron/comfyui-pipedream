      "properties": {},
      "widgets_values": [
        "Product matrix: 3 products x 2 looks = 6 outputs from one graph.\n\n- product (images) and product_prompt (text) share group \"product\": they step together.\n- look multiplies them. product is first in the chain, so it varies fastest.\n- The base image, negative prompt, model and seed stay the same in every job.\n\nLoad your base and product images, pick a checkpoint, then press \"preview wedge\" on PD Save."
      ],
      "widgets_values_named": {
        "text": "Product matrix: 3 products x 2 looks = 6 outputs from one graph.\n\n- product (images) and product_prompt (text) share group \"product\": they step together.\n- look multiplies them. product is first in the chain, so it varies fastest.\n- The base image, negative prompt, model and seed stay the same in every job.\n\nLoad your base and product images, pick a checkpoint, then press \"preview wedge\" on PD Save."
      },
      "color": "#432",
      "bgcolor": "#653"
